WOOCOMMERCE_URL=https://your-store.com
WOOCOMMERCE_CONSUMER_KEY=ck_your_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=cs_your_consumer_secret
# Optional: set both to enable password-protected admin access.
# Strongly recommended before exposing WooOps to the internet.
WOOOPS_ADMIN_PASSWORD=
WOOOPS_SESSION_SECRET=

# Optional: required only if you configure a WooCommerce webhook.
WOOCOMMERCE_WEBHOOK_SECRET=
