WOOCOMMERCE_URL=https://your-store.com
WOOCOMMERCE_CONSUMER_KEY=ck_your_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=cs_your_consumer_secret

# Generate with npm run setup:password. Required for production.
WOOOPS_ADMIN_PASSWORD_HASH=
# Generate at least 32 random characters. Required when login is enabled.
WOOOPS_SESSION_SECRET=
# Exact public origin, without a path. Required for production.
WOOOPS_PUBLIC_URL=https://ops.your-store.com

# Optional: a different password hash for a read-only staff login.
WOOOPS_READONLY_PASSWORD_HASH=
# Optional authenticator secrets: npm run setup:2fa -- admin (or readonly).
WOOOPS_ADMIN_TOTP_SECRET=
WOOOPS_READONLY_TOTP_SECRET=

# Optional signed webhook endpoint.
WOOCOMMERCE_WEBHOOK_SECRET=

# Legacy WOOOPS_ADMIN_PASSWORD works only during local development.
# Replace it with WOOOPS_ADMIN_PASSWORD_HASH before running npm start.
